<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더: ← 뒤로 + 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:contentDescription="뒤로"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설정"
                android:textColor="#7C6AFF"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 음성 인식 엔진 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="음성 인식 엔진"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSttEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEngineOnline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"
                android:text="☁️ 온라인 (최고 정확도)"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEngineOffline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"
                android:text="📴 오프라인"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvSttEngineDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#5555AA"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <!-- Deepgram API 키 (온라인일 때만 표시) -->
        <LinearLayout
            android:id="@+id/groupDeepgramKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etDeepgramKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Deepgram API 키 붙여넣기"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555577"
                    android:textSize="14sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="저장"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#5C6BC0"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9999BB"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="키 발급: deepgram.com 무료 가입 → Console → API Keys → Create a New API Key\n· 소리가 있는 구간만 전송해 요금을 줄입니다 (요금은 Deepgram 정책 확인)\n· 키는 이 휴대폰에만 저장되며 백업되지 않습니다\n· 연결이 안 되면 자동으로 오프라인(Vosk)으로 전환됩니다"
                android:textColor="#5555AA"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- 언어 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="노트 언어"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLangBoth"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="한 + EN"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLangKo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="한국어"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLangEn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 오디오 소스 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오디오 소스"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAudioSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioInternal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 내부 오디오"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudioMic"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 마이크"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvAudioSourceDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="폰 내부 소리만 인식 (볼륨 0도 가능)"
            android:textColor="#5555AA"
            android:textSize="11sp"
            android:layout_marginBottom="20dp"/>

        <!-- STT 모델 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오프라인 음성 인식 모델 (Vosk)"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSttModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelSmall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 빠름"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelLarge"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 정확"
                android:textColor="@color/btn_lang_text"
                app:backgroundTint="@color/btn_lang_bg"
                app:strokeColor="#7C6AFF"
                app:strokeWidth="1.5dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvSttModelDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stt_model_small_desc"
            android:textColor="#5555AA"
            android:textSize="11sp"
            android:layout_marginBottom="20dp"/>

        <!-- 하단 자막 표시 -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBottomSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="하단 자막 표시"
            android:textColor="#AAAACC"
            android:textSize="13sp"
            app:thumbTint="#7C6AFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="화면 아래에 실시간 자막을 표시합니다. 📝 패널이 열려 있을 때는 자동으로 숨겨집니다."
            android:textColor="#5555AA"
            android:textSize="11sp"
            android:layout_marginBottom="20dp"/>

        <!-- 글자 크기 -->
        <TextView
            android:id="@+id/tvFontSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="글자 크기: 18sp"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="12"
            android:valueTo="28"
            android:value="18"
            android:stepSize="1"
            app:thumbColor="#7C6AFF"
            app:trackColorActive="#7C6AFF"
            app:trackColorInactive="#2A2A3A"
            android:layout_marginBottom="20dp"/>

        <!-- 배경 투명도 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="패널 배경 불투명도"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderBgAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="255"
            android:value="180"
            android:stepSize="5"
            app:thumbColor="#FF6A9E"
            app:trackColorActive="#FF6A9E"
            app:trackColorInactive="#2A2A3A"
            android:layout_marginBottom="28dp"/>

        <!-- 앱 정보 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="#2A2A3A"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 정보"
            android:textColor="#AAAACC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="버전"
                android:textColor="#DDDDEE"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9999BB"
                android:textSize="14sp"
                android:textIsSelectable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
