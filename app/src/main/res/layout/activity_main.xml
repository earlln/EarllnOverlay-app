<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 + ⚙️ 설정 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EarllnOverlay"
                android:textColor="#7C6AFF"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="22sp"
                android:contentDescription="설정"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 영→한 자막 노트"
            android:textColor="#6666AA"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/statusIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ 대기"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ 자막 시작"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C6BC0"
                app:cornerRadius="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>

        <!-- 사용 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 사용 방법"
            android:textColor="#7C6AFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. ▶ 자막 시작 버튼 탭 → 권한 요청 시 모두 허용\n2. 화면 위에 📝 자막 노트 버튼이 나타납니다\n3. 다른 앱(X, 브라우저 등)에서 영상 재생\n4. 📝 버튼을 누르면 우측 패널에 문장과 번역이 차곡차곡 쌓입니다\n\n· 패널 상단 바를 드래그하면 이동\n· 📋 전체 복사 · 📤 공유 · ⤢ 크게 · — 숨기기 · ✕ 패널 닫기\n· ⏻ 두 번 누르면 자막 종료 (알림창의 종료 버튼으로도 가능)\n· 문장을 길게 누르면 그 문장만 복사\n· 패널 위 노란 줄: 🔊 소리 감지 여부와 현재 상태 표시\n· 언어/오디오/글자 크기 등은 오른쪽 위 ⚙️ 설정에서 변경\n· 영상 앱이 내부 오디오를 막으면 🎤 마이크로 자동 전환 (볼륨을 켜 두세요)\n· 패널을 닫아도 기록은 유지되며, 자막을 종료하면 삭제됩니다\n· 인스타 등 영상 앱의 음소거(🔇)는 꼭 해제하세요 (휴대폰 볼륨은 0이어도 됨)\n\n⚠ 첫 실행 시 모델 다운로드 필요 (Wi-Fi 권장)\n   · 음성 인식: 빠름 약 40MB / 정확 약 128MB\n   · 번역: 약 30MB\n⚠ 화면 공유 권한은 내부 오디오 캡처에 사용됩니다"
            android:textColor="#6666AA"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>
