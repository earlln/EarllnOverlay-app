<?xml version="1.0" encoding="utf-8"?>
<!-- 우측 반투명 자막 노트 패널 (배경색/투명도는 코드에서 설정) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 헤더: 제목 부분을 드래그하면 패널 이동 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#335C6BC0">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:paddingEnd="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="📝"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <!-- 패널이 좁아지면 버튼 줄을 좌우로 밀어서 볼 수 있음 -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

        <TextView android:id="@+id/btnRefresh" style="@style/NotePanelButton" android:text="🔄"
            android:contentDescription="화면 다시 읽기"/>
        <TextView android:id="@+id/btnCopyAll" style="@style/NotePanelButton" android:text="📋"
            android:contentDescription="전체 복사"/>
        <TextView android:id="@+id/btnShare" style="@style/NotePanelButton" android:text="📤"
            android:contentDescription="공유"/>
        <TextView android:id="@+id/btnClear" style="@style/NotePanelButton" android:text="🗑"
            android:contentDescription="기록 지우기"/>
        <TextView android:id="@+id/btnExpand" style="@style/NotePanelButton" android:text="⤢"
            android:contentDescription="크기 전환"/>
        <TextView android:id="@+id/btnHide" style="@style/NotePanelButton" android:text="—"
            android:contentDescription="숨기기"/>
        <TextView android:id="@+id/btnClose" style="@style/NotePanelButton" android:text="✕"
            android:contentDescription="패널 닫기"/>
        <TextView android:id="@+id/btnQuit" style="@style/NotePanelButton" android:text="⏹"
            android:textColor="#FF8A80"
            android:contentDescription="자막 종료"/>
        </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 캡처 상태 + 소리 입력 여부 (원인 파악용, 항상 표시) -->
    <TextView
        android:id="@+id/tvPanelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="#1A000000"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="🔄 준비 중..."
        android:textColor="#FFD700"
        android:textSize="11sp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="영상을 재생하면\n문장이 여기에 차곡차곡 쌓입니다\n\n문장을 길게 누르면 복사됩니다"
            android:textColor="#9999BB"
            android:textSize="13sp"/>
    </FrameLayout>

    <!-- 지금 인식 중인 문장 (확정되면 위 목록으로 이동) -->
    <LinearLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="#1AFFFFFF"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLiveEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="start"
            android:textColor="#9AA0D0"
            android:textSize="13sp"
            android:textStyle="italic"/>

        <TextView
            android:id="@+id/tvLiveKo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textColor="#BBBBBB"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>

    <!-- 크기 조절 손잡이: 끌어서 가로/세로 크기 변경 -->
    <TextView
        android:id="@+id/resizeHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:gravity="bottom|end"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:text="◢"
        android:textColor="#B3B8C0FF"
        android:textSize="16sp"
        android:contentDescription="크기 조절"/>
</FrameLayout>
