<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 클라우드 백업/기기 이전: API 키 저장소는 제외 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml"/>
    </device-transfer>
</data-extraction-rules>
